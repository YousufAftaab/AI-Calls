# =================================================================
# Annu Beauty Salon — AI Voice Receptionist Demo Configuration
# =================================================================

# [OPTIONAL] OpenAI API Key for GPT-4o voice chat and TTS.
# If left blank, the app will automatically use its built-in Smart Fallback Engine & Web Speech Synthesis.
OPENAI_API_KEY=

# [OPTIONAL] OpenAI model override (default: gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini

# [REQUIRED] Demo mode flag (Default: true)
# When true: simulated telephony, simulated bookings, no real phone billing
DEMO_MODE=true
